DATABASE_URL=postgresql://user:pass@host:6543/dbname?sslmode=require
# Optional pg Pool size (default 5). Use 1 on tiny serverless if connection pressure is an issue.
PG_POOL_MAX=5
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAILS=you@example.com
# Optional — friend invite emails (copyable invite links always work without this)
RESEND_API_KEY=
EMAIL_FROM=TapShop <onboarding@resend.dev>
