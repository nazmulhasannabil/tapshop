DATABASE_URL=postgresql://user:pass@host:6543/dbname?sslmode=require
# Optional pg Pool size (default 5). Use 1 on tiny serverless if connection pressure is an issue.
PG_POOL_MAX=5
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Public URL used in invite emails (defaults to BETTER_AUTH_URL when unset)
APP_URL=https://tapshop-wv29.vercel.app
ADMIN_EMAILS=you@example.com
# Optional — friend invite emails via EmailJS (copyable invite links always work without this)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Firebase web config (public). Used by the Google sign-in button.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin (server). Verifies the Google ID token before creating a session.
# Either set these three, or paste the service account JSON into FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Facebook and Apple buttons are hidden in the UI. To enable them later, add each
# provider's app ID and secret in Firebase Console > Authentication > Sign-in method,
# then unhide those buttons in src/components/auth/social-login.tsx.
# Before `firebase deploy --only auth`, set googleSignIn.supportEmail in firebase.json
# to a Google account that is a member of the Firebase project.

